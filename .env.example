# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://user:password@host:5432/database

# Public site URL (production: https://leaguepour.com)
NEXT_PUBLIC_APP_URL=https://leaguepour.com

# Auth (generate a random secret for production)
AUTH_SECRET=change-me
AUTH_URL=https://leaguepour.com

# Protected cron endpoints (heartbeat, scheduled jobs)
CRON_SECRET=change-me

# Stripe (optional until payments are enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email - LeaguePour and VenueSprocket send on separate Resend teams/quotas (optional)
RESEND_API_KEY=
RESEND_FROM=LeaguePour <hello@leaguepour.com>
RESEND_VS_API_KEY=
# Resend bounce/complaint webhook - one shared endpoint (/api/webhooks/resend) verifies against
# whichever of these is configured; if neither is set, requests are accepted unverified.
RESEND_WEBHOOK_SECRET=
RESEND_VS_WEBHOOK_SECRET=

# Google Places (optional, for venue address lookup)
GOOGLE_PLACES_API_KEY=

# Hostinger CDN cache purge (optional) - generate a token at hPanel -> Profile -> API.
# HOSTINGER_USERNAME is the Hostinger account username, not an email. Without these, deploys
# still work fine; the CDN cache purge just stays a manual hPanel click instead of automatic.
HOSTINGER_API_TOKEN=
HOSTINGER_USERNAME=

# Internal admin access (comma-separated owner emails)
INTERNAL_OWNER_EMAILS=

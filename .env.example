# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://user:password@host:5432/database

# Public site URL (production: https://leaguepour.com)
NEXT_PUBLIC_APP_URL=https://leaguepour.com

# Auth (generate a random secret for production)
AUTH_SECRET=change-me
AUTH_URL=https://leaguepour.com

# Protected cron endpoints (heartbeat, scheduled jobs)
CRON_SECRET=change-me

# Stripe (optional until payments are enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional)
RESEND_API_KEY=
RESEND_FROM=LeaguePour <hello@leaguepour.com>

# Google Places (optional, for venue address lookup)
GOOGLE_PLACES_API_KEY=

# Internal admin access (comma-separated owner emails)
INTERNAL_OWNER_EMAILS=

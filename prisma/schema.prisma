// LeaguePour — participation events for venues
// Prisma 7: datasource URL is configured in prisma.config.ts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["leaguepour_lp"]
}

// ——— Auth (Auth.js / NextAuth compatible) ———

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  venueStaff         VenueStaff[]
  playerProfile      PlayerProfile?
  competitionRegs    CompetitionRegistration[] @relation("RegistrationUser")
  teamCaptainOf      Team[]                    @relation("TeamCaptain")
  teamMemberships    TeamMember[]
  venueFollows       VenueFollow[]
  eventTypePrefs     EventTypePreference[]
  communicationPrefs CommunicationPreference?
  audienceTags       AudienceTag[]
  passwordResetTokens PasswordResetToken[]

  @@schema("leaguepour_lp")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("leaguepour_lp")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("leaguepour_lp")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("leaguepour_lp")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("leaguepour_lp")
}

// ——— Outreach ———

enum OutreachStatus {
  NOT_CONTACTED
  EMAIL_SENT
  RESPONDED
  SIGNED_UP
  NOT_INTERESTED
  BOUNCED
  COMPLAINED

  @@schema("leaguepour_lp")
}

model OutreachContact {
  id          String         @id @default(cuid())
  placeId     String         @unique
  name        String
  address     String
  city        String
  state       String
  country     String         @default("US")
  phone       String?
  website     String?
  /** Harvested from the venue's website — Google Places does not provide emails. */
  email          String?
  emailCheckedAt DateTime?
  rating      Float?
  status      OutreachStatus @default(NOT_CONTACTED)
  emailSentAt DateTime?
  notes       String?
  /**
   * VenueSprocket cold-outreach state for this same business, tracked separately from the
   * LeaguePour fields above so one prospect list serves both campaigns without a join - this
   * is what makes cross-brand suppression (a business shouldn't get cold-emailed by both
   * products in the same window) a single-row check instead of a cross-table query.
   */
  vsEligible         Boolean         @default(false)
  vsEligibilityNote  String?
  vsStatus           OutreachStatus?
  vsEmailSentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@schema("leaguepour_lp")
}

/**
 * Durable run history for scheduled/background jobs (outreach sends, harvests, and any future
 * lifecycle automation), so "is this job actually healthy" is a query instead of a grep through
 * console logs, and a failed run is detectable instead of silently disappearing.
 */
model JobRun {
  id         String    @id @default(cuid())
  /** Stable machine name, e.g. "lp-outreach-send", "vs-outreach-send", "lp-outreach-harvest". */
  job        String
  status     String
  /** Free-form summary (counts, error message) - never PII. */
  detail     String?   @db.Text
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([job, startedAt])
  @@schema("leaguepour_lp")
}

/**
 * Small general-purpose key/value settings store, read/written outside of a full deploy - e.g.
 * the VenueSprocket outreach kill switch (key "vs_outreach_enabled"). Prefer an env var for
 * anything that genuinely never needs to change without a deploy; use this for anything the
 * owner should be able to flip instantly from the admin panel.
 */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@schema("leaguepour_lp")
}

/**
 * Dedup record for lifecycle nudge emails (see src/lib/lifecycle-nudges.ts and the
 * lp-lifecycle/vs-lifecycle cron routes) - each nudge type fires at most once per subject
 * (a venue, a competition, a lead, etc), keyed by a stable string like
 * "venue:{id}:stripe-connect-incomplete". A row existing means "already sent, don't repeat."
 */
model LifecycleNudgeSent {
  key    String   @id
  sentAt DateTime @default(now())

  @@schema("leaguepour_lp")
}

// ——— Venues & staff ———

enum StaffRole {
  OWNER
  MANAGER
  COORDINATOR

  @@schema("leaguepour_lp")
}

enum BillingPlan {
  STARTER
  GROWTH
  PRO
  ELITE

  @@schema("leaguepour_lp")
}

model Venue {
  id              String   @id @default(cuid())
  parentVenueId   String?
  name            String
  slug            String   @unique
  venueType       String
  description     String   @db.Text
  logoUrl         String?
  coverImageUrl   String?
  addressLine1    String?
  city            String?
  state           String?
  postalCode      String?
  country         String   @default("US")
  formattedAddress String?
  latitude        Float?
  longitude       Float?
  googlePlaceId   String?  @unique
  phone           String?
  websiteUrl      String?
  instagramUrl    String?
  facebookUrl     String?
  xUrl            String?
  tiktokUrl       String?
  collectSms      Boolean  @default(false)
  teamEventsDefault Boolean @default(true)
  importAudienceLater Boolean @default(false)
  billingPlan     BillingPlan @default(STARTER)
  platformFeeBps  Int      @default(500)
  stripeAccountId String?  @unique
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)
  /// Stripe Customer id used for platform SaaS billing (distinct from stripeAccountId / Connect)
  stripeBillingCustomerId String?  @unique
  /// Active Stripe Subscription id
  subscriptionId          String?  @unique
  /// Stripe subscription status: active | trialing | past_due | canceled | unpaid | incomplete
  subscriptionStatus      String?
  /// When the current billing period ends (Unix→DateTime from Stripe)
  subscriptionPeriodEnd   DateTime?
  /// "monthly" | "annual" - lets MRR divide annual prices by 12 instead of assuming every
  /// subscriber pays the monthly rate. Null for subscriptions created before this was tracked.
  subscriptionInterval    String?
  isDisabled      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent   Venue?  @relation("VenueGroup", fields: [parentVenueId], references: [id])
  children Venue[] @relation("VenueGroup")

  staff         VenueStaff[]
  competitions  Competition[]
  campaigns     MessageCampaign[]
  audienceTags  AudienceTag[]
  venueFollows  VenueFollow[]
  promoCodes    PromoCode[]

  // VenueSprocket relations
  vsConfig         VenueVsConfig?
  privateEventLeads PrivateEventLead[]
  privateEvents    PrivateEvent[]
  vsCustomers      VsCustomer[]
  vsPayments       VsPayment[]
  menuPackages     MenuPackage[]
  beveragePackages BeveragePackage[]

  @@schema("leaguepour_lp")
}

model VenueStaff {
  id        String    @id @default(cuid())
  venueId   String
  userId    String
  role      StaffRole
  createdAt DateTime  @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@schema("leaguepour_lp")
}

// ——— Player profile ———

model PlayerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  homeCity           String?
  onboardingComplete Boolean  @default(false)
  favoriteTypesNote  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("leaguepour_lp")
}

// ——— Competition domain ———

enum CompetitionKind {
  TRIVIA
  DARTS
  CORNHOLE
  EUCHRE
  POKER
  POOL
  SHUFFLEBOARD
  CUSTOM

  @@schema("leaguepour_lp")
}

enum ScheduleKind {
  ONE_TIME
  RECURRING

  @@schema("leaguepour_lp")
}

enum BracketKind {
  ROUND_ROBIN
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  LADDER
  SEASON
  POINTS
  CUSTOM

  @@schema("leaguepour_lp")
}

enum RegistrationFormat {
  SOLO
  CAPTAIN_TEAM
  TEAM_MEMBERS

  @@schema("leaguepour_lp")
}

enum CompetitionStatus {
  DRAFT
  PUBLISHED
  SIGNUP_OPEN
  SIGNUP_CLOSED
  IN_PROGRESS
  COMPLETED
  ARCHIVED

  @@schema("leaguepour_lp")
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  WAITLIST
  CANCELLED

  @@schema("leaguepour_lp")
}

/// Reference / educational rows (seeded) describing bracket & schedule styles
model CompetitionFormat {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  bracketKind BracketKind
  description String      @db.Text

  @@schema("leaguepour_lp")
}

model Competition {
  id                 String               @id @default(cuid())
  venueId            String
  title              String
  slug               String
  kind               CompetitionKind
  description        String               @db.Text
  signupOpenAt       DateTime
  signupCloseAt      DateTime
  startAt            DateTime
  endAt              DateTime
  entryFeeCents      Int                  @default(0)
  entryFeeCurrency   String               @default("USD")
  teamFormat         RegistrationFormat
  teamSize           Int?
  captainRequired    Boolean              @default(false)
  participantCap     Int?
  waitlistEnabled    Boolean              @default(true)
  rules              String               @db.Text
  waiverText         String?              @db.Text
  scheduleKind       ScheduleKind
  bracketKind        BracketKind
  recurringRule      String?
  bannerUrl          String?
  status             CompetitionStatus    @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  venue            Venue                     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  prizeStructure   PrizeStructure?
  registrations    CompetitionRegistration[]
  teams            Team[]
  matches          Match[]
  standings        Standing[]
  campaigns        MessageCampaign[]

  @@unique([venueId, slug])
  @@schema("leaguepour_lp")
}

model PrizeStructure {
  id            String      @id @default(cuid())
  competitionId String      @unique
  summary       String
  tiers         Json?
  payoutNotes String?     @db.Text

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@schema("leaguepour_lp")
}

model CompetitionRegistration {
  id               String             @id @default(cuid())
  competitionId    String
  userId           String
  status           RegistrationStatus @default(CONFIRMED)
  roleLabel        String?
  waiverAcceptedAt DateTime?
  paymentId        String?            @unique
  teamId           String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation("RegistrationUser", fields: [userId], references: [id], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId], references: [id])
  payment     Payment?    @relation(fields: [paymentId], references: [id])

  @@schema("leaguepour_lp")
}

model Team {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  captainUserId String
  inviteCode    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition   Competition               @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  captain       User                      @relation("TeamCaptain", fields: [captainUserId], references: [id])
  members       TeamMember[]
  registrations CompetitionRegistration[]
  homeMatches   Match[]                   @relation("HomeTeam")
  awayMatches   Match[]                   @relation("AwayTeam")
  standings     Standing[]

  @@schema("leaguepour_lp")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@schema("leaguepour_lp")
}

model Match {
  id            String    @id @default(cuid())
  competitionId String
  round         Int       @default(1)
  label         String?
  homeTeamId    String?
  awayTeamId    String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  homeScore     Int?
  awayScore     Int?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homeTeam    Team?       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team?       @relation("AwayTeam", fields: [awayTeamId], references: [id])

  @@schema("leaguepour_lp")
}

model Standing {
  id            String   @id @default(cuid())
  competitionId String
  teamId        String?
  playerUserId  String?
  rank          Int?
  points        Float    @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  ties          Int      @default(0)
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId], references: [id])

  @@schema("leaguepour_lp")
}

// ——— Marketing & CRM ———

enum CampaignType {
  SIGNUP_CLOSING
  STARTS_TOMORROW
  JOIN_NEXT
  WINNER_RECAP
  CUSTOM

  @@schema("leaguepour_lp")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT

  @@schema("leaguepour_lp")
}

enum CampaignChannel {
  EMAIL
  SMS

  @@schema("leaguepour_lp")
}

model MessageCampaign {
  id            String          @id @default(cuid())
  venueId       String
  competitionId String?
  type          CampaignType
  name          String
  subject       String?
  body          String          @db.Text
  channel       CampaignChannel @default(EMAIL)
  audienceFilter Json?
  status        CampaignStatus  @default(DRAFT)
  scheduledFor  DateTime?
  sentAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  competition Competition? @relation(fields: [competitionId], references: [id])

  @@schema("leaguepour_lp")
}

model AudienceTag {
  id        String   @id @default(cuid())
  venueId   String
  userId    String
  tag       String
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId, tag])
  @@schema("leaguepour_lp")
}

model VenueFollow {
  userId    String
  venueId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
  @@schema("leaguepour_lp")
}

model EventTypePreference {
  userId String
  kind     CompetitionKind
  weight   Int            @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@schema("leaguepour_lp")
}

model CommunicationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  emailOffers     Boolean  @default(true)
  smsOffers       Boolean  @default(false)
  eventReminders  Boolean  @default(true)
  frequency       String   @default("normal")
  globalOptOut    Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("leaguepour_lp")
}

// ——— Payments & notifications (placeholders) ———

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED

  @@schema("leaguepour_lp")
}

enum DiscountType {
  PERCENT
  FLAT

  @@schema("leaguepour_lp")
}

model PromoCode {
  id            String       @id @default(cuid())
  venueId       String?
  code          String       @unique
  discountType  DiscountType
  amount        Int
  usageLimit    Int?
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@schema("leaguepour_lp")
}

model Payment {
  id            String        @id @default(cuid())
  amountCents   Int
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  provider      String        @default("placeholder")
  externalRef   String?
  /// Stripe Checkout Session id (cs_…)
  providerCheckoutSessionId String? @unique
  /// Stripe PaymentIntent id (pi_…)
  providerPaymentIntentId   String? @unique
  /// Stripe Customer id when Checkout creates or attaches one (cus_…)
  providerCustomerId String?
  paidAt        DateTime?
  refundedAt    DateTime?
  /// Last Stripe event id processed for idempotency (evt_…)
  lastWebhookEventId String?
  /// Stripe Connect `application_fee_amount` (cents) for this entry charge
  stripeApplicationFeeCents Int?
  /// Connected account id (`acct_…`) receiving the transfer remainder
  stripeConnectDestinationId String?
  /// Venue `platformFeeBps` at Checkout creation (audit)
  platformFeeBpsSnapshot     Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  registration CompetitionRegistration?

  @@schema("leaguepour_lp")
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED

  @@schema("leaguepour_lp")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   String
  template  String
  payload   Json?
  status    NotificationStatus  @default(QUEUED)
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  @@schema("leaguepour_lp")
}

// ═══════════════════════════════════════════════════════════════
// VenueSprocket — private event management
// ═══════════════════════════════════════════════════════════════

// ——— VS enums ———

enum VsPlan {
  VS_FREE
  VS_STARTER
  VS_PRO
  VS_GROWTH
  VS_ENTERPRISE

  @@schema("leaguepour_lp")
}

enum VsEventType {
  BIRTHDAY
  CORPORATE
  HOLIDAY_PARTY
  REHEARSAL_DINNER
  SHOWER
  FUNDRAISER
  PRIVATE_ROOM
  WEDDING
  ANNIVERSARY
  TASTING
  BUYOUT
  OTHER

  @@schema("leaguepour_lp")
}

enum VsLeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  CONTRACT_SENT
  DEPOSIT_PENDING
  BOOKED
  FINAL_DETAILS
  BEO_READY
  COMPLETED
  LOST

  @@schema("leaguepour_lp")
}

enum VsEventStatus {
  INQUIRY
  PROPOSAL_OUT
  CONTRACT_OUT
  DEPOSIT_DUE
  CONFIRMED
  BEO_DRAFT
  BEO_FINAL
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("leaguepour_lp")
}

enum VsProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED

  @@schema("leaguepour_lp")
}

enum VsContractStatus {
  DRAFT
  SENT
  SIGNED
  VOIDED

  @@schema("leaguepour_lp")
}

enum VsPaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED

  @@schema("leaguepour_lp")
}

enum VsBeoStatus {
  DRAFT
  NEEDS_REVIEW
  FINAL

  @@schema("leaguepour_lp")
}

enum VsMarketingPageType {
  BIRTHDAY_PARTY
  CORPORATE_EVENT
  HOLIDAY_PARTY
  REHEARSAL_DINNER
  SHOWER
  FUNDRAISER
  PRIVATE_DINING
  BUYOUT
  TASTING
  SEASONAL
  CITY
  CUSTOM

  @@schema("leaguepour_lp")
}

enum VsAutomationTrigger {
  LEAD_CREATED
  LEAD_NO_RESPONSE_24H
  LEAD_NO_RESPONSE_72H
  PROPOSAL_VIEWED
  PROPOSAL_ACCEPTED
  CONTRACT_SENT
  CONTRACT_SIGNED
  DEPOSIT_PAID
  EVENT_MINUS_7DAYS
  EVENT_MINUS_1DAY
  EVENT_COMPLETED

  @@schema("leaguepour_lp")
}

// ——— VS venue config ———

/// VenueSprocket-specific settings for a Venue (extends the shared Venue record)
model VenueVsConfig {
  id                 String   @id @default(cuid())
  venueId            String   @unique
  vsPlan             VsPlan   @default(VS_FREE)
  vsEnabled          Boolean  @default(true)
  marketingEnabled   Boolean  @default(false)
  leaguePourEnabled  Boolean  @default(false)
  publicEmail        String?
  publicPhone        String?
  contractTemplate   String?  @db.Text
  defaultDepositPct  Int      @default(25)
  defaultDepositFlat Int?
  timezone           String   @default("America/Chicago")
  /// Active Stripe Subscription id for the VenueSprocket plan (separate from Venue.subscriptionId,
  /// which tracks LeaguePour's subscription). A venue can hold one active subscription per product.
  vsSubscriptionId          String?    @unique
  vsSubscriptionStatus      String?
  vsSubscriptionPeriodEnd   DateTime?
  /// "monthly" | "annual" - see the matching comment on Venue.subscriptionInterval.
  vsSubscriptionInterval    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  venue        Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  eventSpaces  EventSpace[]
  marketingPages VsMarketingPage[]
  automations  VsAutomation[]

  @@schema("leaguepour_lp")
}

// ——— Event spaces (rooms) ———

model EventSpace {
  id               String   @id @default(cuid())
  venueConfigId    String
  name             String
  capacitySeated   Int?
  capacityStanding Int?
  description      String?  @db.Text
  roomFee          Int      @default(0)
  minimumSpend     Int      @default(0)
  amenities        String[]
  photoUrls        String[]
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  venueConfig    VenueVsConfig    @relation(fields: [venueConfigId], references: [id], onDelete: Cascade)
  privateEvents  PrivateEvent[]

  @@schema("leaguepour_lp")
}

// ——— Private event lead ———

model PrivateEventLead {
  id              String       @id @default(cuid())
  venueId         String
  vsCustomerId    String?
  source          String?
  eventType       VsEventType  @default(OTHER)
  preferredDate   DateTime?
  alternateDate   DateTime?
  startTime       String?
  endTime         String?
  guestCount      Int?
  budgetRange     String?
  customerName    String
  customerEmail   String
  customerPhone   String?
  notes           String?      @db.Text
  status          VsLeadStatus @default(NEW)
  assignedUserId  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  privateEvent PrivateEvent?
  vsCustomer   VsCustomer?   @relation(fields: [vsCustomerId], references: [id])

  @@index([venueId, status])
  @@index([customerEmail])
  @@schema("leaguepour_lp")
}

// ——— Private event ———

model PrivateEvent {
  id                   String        @id @default(cuid())
  venueId              String
  leadId               String?       @unique
  eventSpaceId         String?
  vsCustomerId         String?
  eventName            String
  eventType            VsEventType   @default(OTHER)
  eventDate            DateTime
  startTime            String
  endTime              String
  setupTime            String?
  teardownTime         String?
  guestCountEstimated  Int?
  guestCountFinal      Int?
  status               VsEventStatus @default(INQUIRY)
  internalNotes        String?       @db.Text
  customerNotes        String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  venue       Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  lead        PrivateEventLead? @relation(fields: [leadId], references: [id])
  eventSpace  EventSpace?       @relation(fields: [eventSpaceId], references: [id])
  vsCustomer  VsCustomer?       @relation(fields: [vsCustomerId], references: [id])
  proposals   VsProposal[]
  contracts   VsContract[]
  vsPayments  VsPayment[]
  beos        VsBeo[]

  @@index([venueId, eventDate])
  @@schema("leaguepour_lp")
}

// ——— Customer CRM ———

model VsCustomer {
  id              String   @id @default(cuid())
  venueId         String
  name            String
  email           String
  phone           String?
  company         String?
  notes           String?  @db.Text
  tags            String[]
  marketingOptIn  Boolean  @default(false)
  source          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  venue         Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  privateEvents PrivateEvent[]
  leads         PrivateEventLead[]

  @@unique([venueId, email])
  @@index([venueId])
  @@schema("leaguepour_lp")
}

// ——— Proposal ———

model VsProposal {
  id              String           @id @default(cuid())
  privateEventId  String
  version         Int              @default(1)
  status          VsProposalStatus @default(DRAFT)
  lineItems       Json?
  packageOptions  Json?
  minimumSpend    Int              @default(0)
  roomFee         Int              @default(0)
  taxesFees       Int              @default(0)
  depositAmount   Int              @default(0)
  totalAmount     Int              @default(0)
  publicToken     String           @unique @default(cuid())
  expiresAt       DateTime?
  viewedAt        DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  privateEvent PrivateEvent @relation(fields: [privateEventId], references: [id], onDelete: Cascade)
  contract     VsContract?

  @@schema("leaguepour_lp")
}

// ——— Contract ———

model VsContract {
  id             String           @id @default(cuid())
  privateEventId String
  proposalId     String?          @unique
  version        Int              @default(1)
  status         VsContractStatus @default(DRAFT)
  contractText   String           @db.Text
  signerName     String?
  signerEmail    String?
  typedSignature String?
  signedAt       DateTime?
  ipAddress      String?
  userAgent      String?
  pdfUrl         String?
  publicToken    String           @unique @default(cuid())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  privateEvent PrivateEvent @relation(fields: [privateEventId], references: [id], onDelete: Cascade)
  proposal     VsProposal?  @relation(fields: [proposalId], references: [id])

  @@schema("leaguepour_lp")
}

// ——— Deposit / payment ———

model VsPayment {
  id                     String          @id @default(cuid())
  venueId                String
  privateEventId         String
  stripePaymentIntentId  String?         @unique
  stripeCheckoutSessionId String?        @unique
  amountCents            Int
  currency               String          @default("USD")
  type                   String          @default("deposit")
  status                 VsPaymentStatus @default(PENDING)
  dueDate                DateTime?
  paidAt                 DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  venue        Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  privateEvent PrivateEvent @relation(fields: [privateEventId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@schema("leaguepour_lp")
}

// ——— BEO ———

model VsBeo {
  id                  String      @id @default(cuid())
  privateEventId      String
  version             Int         @default(1)
  status              VsBeoStatus @default(DRAFT)
  eventSummary        String?     @db.Text
  contactInfo         Json?
  timeline            Json?
  roomSetup           String?     @db.Text
  foodDetails         String?     @db.Text
  beverageDetails     String?     @db.Text
  staffingNotes       String?     @db.Text
  avNeeds             String?     @db.Text
  allergies           String?     @db.Text
  specialInstructions String?     @db.Text
  internalNotes       String?     @db.Text
  pdfUrl              String?
  finalizedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  privateEvent PrivateEvent @relation(fields: [privateEventId], references: [id], onDelete: Cascade)

  @@schema("leaguepour_lp")
}

// ——— Menu and beverage packages ———

model MenuPackage {
  id          String   @id @default(cuid())
  venueId     String
  name        String
  description String?  @db.Text
  priceType   String   @default("per_person")
  priceCents  Int      @default(0)
  items       Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@schema("leaguepour_lp")
}

model BeveragePackage {
  id          String   @id @default(cuid())
  venueId     String
  name        String
  description String?  @db.Text
  priceType   String   @default("per_person")
  priceCents  Int      @default(0)
  items       Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@schema("leaguepour_lp")
}

// ——— Marketing pages ———

model VsMarketingPage {
  id              String              @id @default(cuid())
  venueConfigId   String
  pageType        VsMarketingPageType
  slug            String
  title           String
  metaDescription String?
  content         Json?
  targetKeyword   String?
  city            String?
  eventType       VsEventType?
  isPublished     Boolean             @default(false)
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  venueConfig VenueVsConfig @relation(fields: [venueConfigId], references: [id], onDelete: Cascade)

  @@unique([venueConfigId, slug])
  @@schema("leaguepour_lp")
}

// ——— Automations ———

model VsAutomation {
  id              String              @id @default(cuid())
  venueConfigId   String
  name            String
  trigger         VsAutomationTrigger
  delayHours      Int                 @default(0)
  emailSubject    String?
  emailBody       String?             @db.Text
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  venueConfig VenueVsConfig @relation(fields: [venueConfigId], references: [id], onDelete: Cascade)

  @@schema("leaguepour_lp")
}
